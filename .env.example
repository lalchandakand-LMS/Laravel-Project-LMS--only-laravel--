# Production-safe environment template for Alom's English Center.
# For local development, copy .env.local.example to .env instead.
# Never commit real credentials. Set APP_KEY and all service credentials privately in cPanel.

APP_NAME="Alom's English Center"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://alomsenglishcenter.com
APP_TIMEZONE=Asia/Dhaka

# Optional Google OAuth sign-in. Register the exact HTTPS callback URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://alomsenglishcenter.com/auth/google/callback
GOOGLE_REPORTING_REDIRECT_URI=https://alomsenglishcenter.com/admin/seo/google/callback

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Create a dedicated production MySQL database and least-privilege database user in cPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DATABASE
DB_USERNAME=CHANGE_ME_USER
DB_PASSWORD=

# Use HTTPS-only sessions in production.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=alomsenglishcenter.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com # Replace with a verified sender address before production
MAIL_FROM_NAME="${APP_NAME}"

# Keep optional integrations disabled until credentials are installed and tested.
LIVE_CLASS_EMAIL_NOTIFICATIONS=false
LIVE_CLASS_SMS_NOTIFICATIONS=false
LIVE_CLASS_SMS_PROVIDER=mimsms
MIMSMS_API_ENDPOINT=https://api.mimsms.com/api/V2/SMS
MIMSMS_USERNAME=
MIMSMS_API_KEY=
MIMSMS_SENDER_NAME=
LIVE_CLASS_SMS_CONNECT_TIMEOUT=5
LIVE_CLASS_SMS_TIMEOUT=15

AI_AGENTS_ENABLED=false
AI_AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
AI_AGENT_TIMEOUT=45
AI_AGENT_MAX_PROMPT_LENGTH=4000
